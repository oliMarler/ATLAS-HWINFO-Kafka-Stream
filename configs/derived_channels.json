[
  {
    "metric_key": "CPU0_Tctl_F",
    "formula": "$CPU0_CPUTctlTdie * 1.8 + 32",
    "units": "F",
    "description": "CPU Tctl/Tdie in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU0_CPUDieAverage_F",
    "formula": "$CPU0_CPUDieAverage * 1.8 + 32",
    "units": "F",
    "description": "CPU die average temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU0_CCD1_F",
    "formula": "$CPU0_CPUCCD1Tdie * 1.8 + 32",
    "units": "F",
    "description": "CPU CCD1 (Tdie) in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU0_CCD2_F",
    "formula": "$CPU0_CPUCCD2Tdie * 1.8 + 32",
    "units": "F",
    "description": "CPU CCD2 (Tdie) in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU0_IODHotspot_F",
    "formula": "$CPU0_CPUIODHotspot * 1.8 + 32",
    "units": "F",
    "description": "CPU IOD hotspot in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU0_Temp_F",
    "formula": "$GPU0_GPUTemperature * 1.8 + 32",
    "units": "F",
    "description": "GPU0 (NVIDIA) temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU0_MemJunction_F",
    "formula": "$GPU0_GPUMemoryJunctionTemperature * 1.8 + 32",
    "units": "F",
    "description": "GPU0 memory junction temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 300,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU1_Temp_F",
    "formula": "$GPU1_GPUTemperature * 1.8 + 32",
    "units": "F",
    "description": "GPU1 (AMD iGPU) temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Drive_D_Temp_F",
    "formula": "$SMART_DriveTemperature * 1.8 + 32",
    "units": "F",
    "description": "Drive [D:] temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Drive_C_Temp_F",
    "formula": "$SMART_DriveTemperature_2 * 1.8 + 32",
    "units": "F",
    "description": "Drive [C:] temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Board_CPU_Temp_F",
    "formula": "$MSIMAGB650TOMAHAWKWIFI_CPU * 1.8 + 32",
    "units": "F",
    "description": "Motherboard's own CPU-area temperature sensor in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Board_VR_Temp_F",
    "formula": "$MSIMAGB650TOMAHAWKWIFI_VR * 1.8 + 32",
    "units": "F",
    "description": "Motherboard VRM temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Board_Chipset_Temp_F",
    "formula": "$MSIMAGB650TOMAHAWKWIFI_Chipset * 1.8 + 32",
    "units": "F",
    "description": "Motherboard chipset temperature in Fahrenheit",
    "min_value": 32,
    "max_value": 250,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_Thermal_Headroom_C",
    "formula": "95 - $CPU0_CPUTctlTdie",
    "units": "C",
    "description": "Degrees below the ~95C CPU Tjmax before thermal throttling",
    "min_value": -20,
    "max_value": 95,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_Thermal_Headroom_F",
    "formula": "$CPU_Thermal_Headroom_C * 1.8",
    "units": "F",
    "description": "CPU thermal headroom in Fahrenheit degrees (a delta, not an absolute temperature)",
    "min_value": -36,
    "max_value": 171,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_PPT_Headroom_Pct",
    "formula": "100 - $CPU0_CPUPPTLimit",
    "units": "%",
    "description": "Percent below the CPU package power (PPT) limit before it throttles",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_TDC_Headroom_Pct",
    "formula": "100 - $CPU0_CPUTDCLimit",
    "units": "%",
    "description": "Percent below the CPU thermal design current (TDC) limit",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_EDC_Headroom_Pct",
    "formula": "100 - $CPU0_CPUEDCLimit",
    "units": "%",
    "description": "Percent below the CPU electrical design current (EDC) limit",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_Thermal_Margin_Pct",
    "formula": "100 - $CPU0_ThermalLimit",
    "units": "%",
    "description": "Percent margin before HWiNFO's own CPU thermal limit indicator trips",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU0_Thermal_Headroom_C",
    "formula": "83 - $GPU0_GPUTemperature",
    "units": "C",
    "description": "Degrees below the ~83C typical NVIDIA throttle point",
    "min_value": -20,
    "max_value": 83,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU0_Thermal_Headroom_F",
    "formula": "$GPU0_Thermal_Headroom_C * 1.8",
    "units": "F",
    "description": "GPU0 thermal headroom in Fahrenheit degrees (a delta, not an absolute temperature)",
    "min_value": -36,
    "max_value": 149,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU1_Thermal_Headroom_C",
    "formula": "95 - $GPU1_GPUTemperature",
    "units": "C",
    "description": "Degrees below a ~95C typical iGPU throttle point",
    "min_value": -20,
    "max_value": 95,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Drive_D_Thermal_Headroom_C",
    "formula": "70 - $SMART_DriveTemperature",
    "units": "C",
    "description": "Degrees below the ~70C NVMe thermal warning threshold, drive [D:]",
    "min_value": -30,
    "max_value": 70,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Drive_C_Thermal_Headroom_C",
    "formula": "70 - $SMART_DriveTemperature_2",
    "units": "C",
    "description": "Degrees below the ~70C NVMe thermal warning threshold, drive [C:]",
    "min_value": -30,
    "max_value": 70,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_VRM_Core_Power_W",
    "formula": "$CPU0_CPUVDDCRVDDVoltageSVI3TFN * $CPU0_CPUCoreCurrentSVI3TFN",
    "units": "W",
    "description": "Core VRM rail power computed as V x A from SVI3 telemetry",
    "min_value": 0,
    "max_value": 200,
    "format_string": "%6.2f"
  },
  {
    "metric_key": "CPU_VRM_SoC_Power_W",
    "formula": "$CPU0_CPUVDDCRSOCVoltageSVI3TFN * $CPU0_SoCCurrentSVI3TFN",
    "units": "W",
    "description": "SoC VRM rail power computed as V x A from SVI3 telemetry",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%6.2f"
  },
  {
    "metric_key": "CPU_VRM_Misc_Power_W",
    "formula": "$CPU0_CPUVDDMISCVoltageSVI3TFN * $CPU0_MISCCurrentSVI3TFN",
    "units": "W",
    "description": "Misc VRM rail power computed as V x A from SVI3 telemetry",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%6.2f"
  },
  {
    "metric_key": "CPU_VRM_Total_Power_W",
    "formula": "$CPU_VRM_Core_Power_W + $CPU_VRM_SoC_Power_W + $CPU_VRM_Misc_Power_W",
    "units": "W",
    "description": "Sum of Core+SoC+Misc VRM rail power, a cross-check against CPU Package Power",
    "min_value": 0,
    "max_value": 300,
    "format_string": "%6.2f"
  },
  {
    "metric_key": "CPU_VRM_vs_Package_Delta_W",
    "formula": "$CPU_VRM_Total_Power_W - $CPU0_CPUPackagePower",
    "units": "W",
    "description": "Difference between summed VRM rail power and HWiNFO's reported CPU Package Power",
    "min_value": -100,
    "max_value": 100,
    "format_string": "%6.2f"
  },
  {
    "metric_key": "CPU_MHz_per_Watt",
    "formula": "$CPU0_AverageEffectiveClock / ($CPU0_CPUPackagePower + 0.001)",
    "units": "MHz/W",
    "description": "CPU clock achieved per watt of package power, a rough efficiency indicator",
    "min_value": 0,
    "max_value": 2000,
    "format_string": "%7.1f"
  },
  {
    "metric_key": "GPU0_MHz_per_Watt",
    "formula": "$GPU0_GPUClock / ($GPU0_GPUPower + 0.001)",
    "units": "MHz/W",
    "description": "GPU0 clock achieved per watt of GPU power",
    "min_value": 0,
    "max_value": 2000,
    "format_string": "%7.1f"
  },
  {
    "metric_key": "CPU_Watt_per_Usage_Pct",
    "formula": "$CPU0_CPUPackagePower / ($CPU0_TotalCPUUsage + 0.001)",
    "units": "W/%",
    "description": "Package power per percent of CPU usage; rises when a few threads are boosting rather than the whole chip working",
    "min_value": 0,
    "max_value": 500,
    "format_string": "%7.2f"
  },
  {
    "metric_key": "GPU0_FPS_per_Watt",
    "formula": "$PresentMonDwmExe_FrameratePresentedAvg / ($GPU0_GPUPower + 0.001)",
    "units": "FPS/W",
    "description": "Desktop compositor framerate per watt of GPU0 power",
    "min_value": 0,
    "max_value": 50,
    "format_string": "%6.2f"
  },
  {
    "metric_key": "Fan_RPM_per_CPU_Load",
    "formula": "$MSIMAGB650TOMAHAWKWIFI_CPU_Fan / ($CPU0_TotalCPUUsage + 1)",
    "units": "RPM/%",
    "description": "CPU fan speed relative to CPU load; a flat curve here suggests the fan isn't responding to load",
    "min_value": 0,
    "max_value": 2000,
    "format_string": "%7.1f"
  },
  {
    "metric_key": "CPU_CCD_Imbalance_C",
    "formula": "$CPU0_CPUCCD1Tdie - $CPU0_CPUCCD2Tdie",
    "units": "C",
    "description": "Temperature difference between the two CCDs; a large gap suggests uneven core scheduling",
    "min_value": -50,
    "max_value": 50,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_Internal_vs_Board_Sensor_Delta_C",
    "formula": "$CPU0_CPUTctlTdie - $MSIMAGB650TOMAHAWKWIFI_CPU",
    "units": "C",
    "description": "Difference between HWiNFO's internal Tctl/Tdie reading and the motherboard's own CPU-area sensor",
    "min_value": -50,
    "max_value": 50,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "GPU0_MemJunction_vs_Core_Delta_C",
    "formula": "$GPU0_GPUMemoryJunctionTemperature - $GPU0_GPUTemperature",
    "units": "C",
    "description": "How much hotter GPU0 memory runs than the GPU core",
    "min_value": -20,
    "max_value": 80,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Drive_Temp_Delta_C",
    "formula": "$SMART_DriveTemperature - $SMART_DriveTemperature_2",
    "units": "C",
    "description": "Temperature difference between the two NVMe drives ([D:] minus [C:])",
    "min_value": -50,
    "max_value": 50,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Memory_Load_Delta_Pct",
    "formula": "$System_PhysicalMemoryLoad - $System_VirtualMemoryLoad",
    "units": "%",
    "description": "Physical memory load minus virtual memory load",
    "min_value": -100,
    "max_value": 100,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "CPU_vs_GPU0_Temp_Delta_C",
    "formula": "$CPU0_CPUTctlTdie - $GPU0_GPUTemperature",
    "units": "C",
    "description": "CPU temperature minus GPU0 temperature",
    "min_value": -50,
    "max_value": 50,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "System_Combined_Load_Pct",
    "formula": "($CPU0_TotalCPUUsage + $GPU0_GPUCoreLoad + $System_PhysicalMemoryLoad) / 3",
    "units": "%",
    "description": "Average of CPU usage, GPU0 core load and physical memory load, one number for overall system pressure",
    "min_value": 0,
    "max_value": 100,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "System_Hottest_Temp_C",
    "formula": "$CPU0_CPUTctlTdie if $CPU0_CPUTctlTdie > $GPU0_GPUTemperature else $GPU0_GPUTemperature",
    "units": "C",
    "description": "The hotter of CPU and GPU0 temperature",
    "min_value": 0,
    "max_value": 120,
    "format_string": "%5.1f"
  },
  {
    "metric_key": "Total_System_Power_W",
    "formula": "$CPU0_CPUPackagePower + $GPU0_GPUPower + $GPU1_GPUASICPower",
    "units": "W",
    "description": "CPU package power plus GPU0 power plus GPU1 (iGPU) ASIC power",
    "min_value": 0,
    "max_value": 1000,
    "format_string": "%6.1f"
  },
  {
    "metric_key": "CPU_Hot_Flag",
    "formula": "1.0 if $CPU0_CPUTctlTdie > 85 else 0.0",
    "units": "",
    "description": "1 when CPU Tctl/Tdie exceeds 85C, else 0",
    "min_value": 0,
    "max_value": 1,
    "format_string": "%3.0f"
  },
  {
    "metric_key": "GPU0_Hot_Flag",
    "formula": "1.0 if $GPU0_GPUTemperature > 75 else 0.0",
    "units": "",
    "description": "1 when GPU0 temperature exceeds 75C, else 0",
    "min_value": 0,
    "max_value": 1,
    "format_string": "%3.0f"
  },
  {
    "metric_key": "GPU0_MemJunction_Hot_Flag",
    "formula": "1.0 if $GPU0_GPUMemoryJunctionTemperature > 95 else 0.0",
    "units": "",
    "description": "1 when GPU0 memory junction temperature exceeds 95C, else 0",
    "min_value": 0,
    "max_value": 1,
    "format_string": "%3.0f"
  },
  {
    "metric_key": "Drive_Hot_Flag",
    "formula": "1.0 if $SMART_DriveTemperature > 55 else 0.0",
    "units": "",
    "description": "1 when drive [D:] temperature exceeds 55C, else 0",
    "min_value": 0,
    "max_value": 1,
    "format_string": "%3.0f"
  },
  {
    "metric_key": "Memory_Pressure_Flag",
    "formula": "1.0 if $System_PhysicalMemoryLoad > 85 else 0.0",
    "units": "",
    "description": "1 when physical memory load exceeds 85%, else 0",
    "min_value": 0,
    "max_value": 1,
    "format_string": "%3.0f"
  },
  {
    "metric_key": "CPU_Near_PPT_Limit_Flag",
    "formula": "1.0 if $CPU0_CPUPPTLimit > 90 else 0.0",
    "units": "",
    "description": "1 when CPU PPT limit usage exceeds 90%, else 0",
    "min_value": 0,
    "max_value": 1,
    "format_string": "%3.0f"
  },
  {
    "metric_key": "Network_Total_Rate_KBps",
    "formula": "$Network_CurrentDLRate + $Network_CurrentUPRate",
    "units": "KB/s",
    "description": "Combined download+upload throughput on the wired NIC",
    "min_value": 0,
    "max_value": 500000,
    "format_string": "%8.1f"
  },
  {
    "metric_key": "DRAM_Total_Bandwidth_GBps",
    "formula": "$CPU0_DRAMReadBandwidth + $CPU0_DRAMWriteBandwidth",
    "units": "GB/s",
    "description": "Combined DRAM read+write bandwidth",
    "min_value": 0,
    "max_value": 128,
    "format_string": "%6.2f"
  }
]
